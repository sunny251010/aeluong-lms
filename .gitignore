# Local WordPress configuration and generated files
/wp-config.php
/local-*.php
/.htaccess
.env
.env.*
*.pem
*.key
id_rsa
id_ed25519

# WordPress core files. Keep the repository focused on custom project code.
/index.php
/license.txt
/readme.html
/wp-*.php
/xmlrpc.php
/wp-admin/
/wp-includes/

# User uploads, cache, backups, and local runtime artifacts
/wp-content/uploads/
/wp-content/cache/
/wp-content/upgrade/
/wp-content/backups/
/wp-content/ai1wm-backups/
/wp-content/backup*/
/wp-content/debug.log
*.log
*.sql
*.sql.gz
*.zip
*.tar
*.tar.gz

# Third-party themes/plugins should normally be installed through WP Admin.
# Track only project-owned custom code.
/wp-content/themes/*
!/wp-content/themes/index.php
!/wp-content/themes/lms-kadence-child/
!/wp-content/themes/lms-kadence-child/**
/wp-content/plugins/*
!/wp-content/plugins/index.php
!/wp-content/plugins/aeluong-site-core/
!/wp-content/plugins/aeluong-site-core/**

# Dependency and build artifacts
node_modules/
vendor/
dist/
build/
.cache/

# OS and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
